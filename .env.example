# ==============================================================================
# LA JEFATURA SUITE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy to `.env` on your Hostinger VPS:  cp .env.example .env
# NEVER commit `.env` to Git (it is strictly ignored in .gitignore).
# ==============================================================================

# ── 1. CORE SERVER & SECURITY GATE ───────────────────────────────────────────
PORT=8931
# Access key required on public URLs (?key=...) unless authenticated via X-MC-Token
MC_DEMO_KEY=mc-demo-2026-x9f4
# Shared webhook secret token used by UniTEC / BuildingApp / Local ISAPI Camera Agent
MC_TOKEN=replace_with_mc_token_secret
# Optional custom SQLite database path (defaults to ./data/mc.db)
# MC_DB_PATH=/opt/la-jefatura-suite/data/mc.db

# ── 2. HIK-CONNECT CLOUD API v3 (5 DEVICES · 55 CAMERA CHANNELS) ─────────────
# Connects to api.hik-connect.com -> apiisa.hik-connect.com every 5 minutes
# and builds the 07:30 AM Daily Executive Camera Report.
HIKCONNECT_ACCOUNT=your_hikconnect_email_or_username
HIKCONNECT_PASSWORD=your_hikconnect_password

# ── 3. BUILDINGAPP AI (https://buildingapp.us · Web + iOS App Store + Play) ──
# Pulls live registered members, credit limits, AI generations, and USD spend.
BUILDINGAPP_BASE_URL=https://buildingapp.us
BUILDINGAPP_ADMIN_EMAIL=admin@buildingapp.us
BUILDINGAPP_ADMIN_PASSWORD=your_buildingapp_admin_password

# ── 4. UNITEC USA & BUILDING INNOVATION AI RECEPTIONIST CHATBOT ──────────────
# Pulls live sessions, funnel, intents, and Firestore escalations.
UNITEC_BASE_URL=https://unitec-front-desk.vercel.app
UNITEC_CUSTOM_DOMAIN=https://www.chatbuildinginnovation.us
UNITEC_ADMIN_EMAIL=admin@unitecdesign.com
UNITEC_ADMIN_PASSWORD=your_unitec_admin_password
# Path to Firebase Admin SDK JSON (chatbot-bi-front-desk) on the VPS disk:
FIREBASE_SA_PATH=/opt/la-jefatura-suite/data/chatbot-bi-front-desk-sa.json

# ── 5. OFFICIAL META WHATSAPP CLOUD API (Graph API v21.0 · Zero Ban Risk) ────
# Replaces Green API. Monitors selected 1:1 chats & groups -> Auto-Draft + Auto-Task.
# Webhook URL to set in Meta App Dashboard: https://YOUR-DOMAIN.COM/api/whatsapp/webhook
META_WA_VERIFY_TOKEN=lajefatura-meta-verify-2026
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=

# ── 6. EMAIL (BREVO SMTP API) & TELEGRAM BOT ALERTS ──────────────────────────
BREVO_API_KEY=
TG_BOT_TOKEN=
TG_OWNER_CHAT_ID=
